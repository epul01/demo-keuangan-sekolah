generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Admin {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Siswa {
  id         String   @id @default(cuid())
  nama       String
  nis        String   @unique
  kelas      String
  namaWali   String
  nomorHP    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  spp        SPP[]
}

model SPP {
  id        String   @id @default(cuid())
  siswaId   String
  siswa     Siswa    @relation(fields: [siswaId], references: [id], onDelete: Cascade)
  bulan     Int
  tahun     Int
  nominal   Float
  status    String   @default("belum") // lunas / belum
  tanggalBayar DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Pemasukan {
  id          String   @id @default(cuid())
  jenis       String
  nominal     Float
  tanggal     DateTime
  keterangan  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Pengeluaran {
  id          String   @id @default(cuid())
  jenis       String
  nominal     Float
  tanggal     DateTime
  keterangan  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
