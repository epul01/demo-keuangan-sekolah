# ============================================
# DATABASE - Vercel Postgres (untuk production/deploy)
# ============================================
# Dapatkan connection string dari:
# 1. Buka vercel.com/dashboard
# 2. Pilih project → tab Storage → database Postgres
# 3. Salin POSTGRES_PRISMA_URL dan POSTGRES_URL_NON_POOLING
#
# DATABASE_URL = untuk runtime (dengan connection pooling / pgbouncer)
# DIRECT_URL   = untuk Prisma migration (tanpa pooling)

DATABASE_URL="postgresql://user:password@host/dbname?pgbouncer=true&connect_timeout=15&sslmode=require"
DIRECT_URL="postgresql://user:password@host/dbname?connect_timeout=15&sslmode=require"

# ============================================
# AUTH - JWT Secret
# ============================================
# Ganti dengan secret key acak yang panjang untuk production!
# Contoh: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-key-change-in-production
